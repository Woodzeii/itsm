{
  "components": {
    "schemas": {
      "CreateAssetClassAttributeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "isRequired": {
            "type": "boolean"
          },
          "defaultValue": {
            "type": "string",
            "nullable": true
          },
          "options": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateAssetClassRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateAssetRequest": {
        "type": "object",
        "required": [
          "name",
          "assetClassId"
        ],
        "properties": {
          "inventoryNumber": {
            "type": "string",
            "nullable": true,
            "description": "Необязателен только на этапе «Закуплен»."
          },
          "name": {
            "type": "string"
          },
          "assetClassId": {
            "type": "integer"
          },
          "warehouseId": {
            "type": "integer",
            "nullable": true,
            "description": "Если inventoryNumber задан, поле обязательно: актив сразу создается на этапе «На складе» (АКТ-19). Без inventoryNumber актив создается на этапе «Закуплен»."
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "UpdateAssetRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "RegisterAssetMovementRequest": {
        "type": "object",
        "required": [
          "movementType"
        ],
        "properties": {
          "movementType": {
            "type": "string",
            "enum": [
              "TransferToEmployee",
              "Relocation",
              "WarehouseIssue",
              "WarehouseReturn"
            ]
          },
          "fromSourceId": {
            "type": "integer",
            "nullable": true
          },
          "toDestinationId": {
            "type": "integer",
            "nullable": true
          },
          "assignedUserId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateDictionaryRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDictionaryValueRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DisableTwoFactorRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UpdateAssetClassAttributeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "isRequired": {
            "type": "boolean"
          },
          "defaultValue": {
            "type": "string",
            "nullable": true
          },
          "options": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "UpdateAssetClassRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "UpdateDictionaryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "UpdateDictionaryValueRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "VerifyTwoFactorRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "VerifyTwoFactorSetupRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "TwoFactorSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "otpAuthUri": {
            "type": "string"
          },
          "qrCodeImageBase64": {
            "type": "string",
            "description": "PNG в Base64 без префикса data URI"
          },
          "issuer": {
            "type": "string"
          }
        }
      },
      "CreateTicketRequest": {
        "type": "object",
        "description": "Для встроенного типа «Тикет на ремонт» заявку создает инженер ТП; assetId обязателен, актив должен находиться на этапе «На складе» или «В эксплуатации». Создание такого тикета автоматически переводит актив в этап «В ремонте».",
        "required": [
          "title",
          "description",
          "typeId",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "typeId": {
            "type": "integer"
          },
          "priority": {
            "type": "string"
          },
          "assetId": {
            "type": "integer",
            "nullable": true,
            "description": "Для обычных заявок может быть null. Для тикета на ремонт обязателен; связь с активом одна на заявку."
          },
          "customFieldsData": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "AssignTicketRequest": {
        "type": "object",
        "required": [
          "assigneeId"
        ],
        "properties": {
          "assigneeId": {
            "type": "integer",
            "format": "int32",
            "description": "ID активного инженера технической поддержки."
          }
        }
      },
      "UpdateTicketRequest": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string"
          },
          "assigneeId": {
            "type": "integer",
            "nullable": true
          },
          "customFieldsData": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ChangeTicketStatusRequest": {
        "type": "object",
        "required": [
          "statusId"
        ],
        "properties": {
          "statusId": {
            "type": "integer"
          },
          "repairResolution": {
            "type": "string",
            "nullable": true,
            "description": "Свободное описание выполненного ремонта; обязательно при закрытии тикета на ремонт (АКТ-16)."
          },
          "repairOutcome": {
            "type": "string",
            "nullable": true,
            "enum": [
              "ReturnToExploitation",
              "TransferToWarehouse",
              "Retire"
            ],
            "description": "Обязателен при закрытии тикета на ремонт. Автоматически переводит актив соответственно в «В эксплуатации», «На складе» или «Списан» (АКТ-12)."
          }
        }
      },
      "CreateTicketMessageRequest": {
        "type": "object",
        "required": [
          "messageBody"
        ],
        "properties": {
          "messageBody": {
            "type": "string"
          },
          "isInternal": {
            "type": "boolean",
            "default": false
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SaveFormTemplateRequest": {
        "type": "object",
        "required": [
          "fieldsSchema"
        ],
        "properties": {
          "fieldsSchema": {
            "$ref": "#/components/schemas/FormTemplateFieldsSchema"
          }
        }
      },
      "FormTemplateFieldsSchema": {
        "type": "object",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormFieldDefinition"
            }
          }
        }
      },
      "FormFieldDefinition": {
        "type": "object",
        "required": [
          "code",
          "name",
          "fieldType",
          "isRequired",
          "isEngineerOnly"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fieldType": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "number",
              "date",
              "dictionary",
              "asset",
              "attachment",
              "boolean"
            ]
          },
          "isRequired": {
            "type": "boolean"
          },
          "isEngineerOnly": {
            "type": "boolean",
            "description": "Поле заполняется только инженером технической поддержки."
          },
          "defaultValue": {
            "type": "string",
            "nullable": true
          },
          "hint": {
            "type": "string",
            "nullable": true
          },
          "dictionaryId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "visibilities": {
            "type": "array",
            "description": "Настройка видимости и редактирования поля по системным ролям, включая роль автора заявки на портале (FORM-10).",
            "items": {
              "$ref": "#/components/schemas/FormFieldVisibilityRule"
            }
          },
          "dependencies": {
            "type": "array",
            "description": "Условия отображения поля, вычисляемые по значениям других полей (FORM-07).",
            "items": {
              "$ref": "#/components/schemas/FieldDependency"
            }
          }
        }
      },
      "FormFieldVisibilityRule": {
        "type": "object",
        "required": [
          "roleCode",
          "isVisible",
          "isEditable"
        ],
        "properties": {
          "roleCode": {
            "type": "string"
          },
          "isVisible": {
            "type": "boolean"
          },
          "isEditable": {
            "type": "boolean"
          }
        }
      },
      "FieldDependency": {
        "type": "object",
        "required": [
          "dependsOnFieldCode",
          "condition"
        ],
        "properties": {
          "dependsOnFieldCode": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "enum": [
              "Equals",
              "NotEquals",
              "Filled"
            ]
          },
          "value": {
            "type": "string",
            "nullable": true,
            "description": "Сравниваемое значение для Equals или NotEquals; для Filled не требуется."
          }
        }
      },
      "TicketType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "isBuiltIn": {
            "type": "boolean"
          },
          "isPortalAvailable": {
            "type": "boolean"
          }
        }
      },
      "AssetHistoryItem": {
        "type": "object",
        "required": [
          "id",
          "actionType",
          "description",
          "performedBy",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "actionType": {
            "type": "string",
            "enum": [
              "entity_created",
              "attribute_changed",
              "movement",
              "stage_changed",
              "assigned_changed",
              "ticket_created",
              "ticket_closed"
            ],
            "description": "Типы действий соответствуют AssetHistoryActionTypes в backend."
          },
          "description": {
            "type": "string",
            "description": "Человекочитаемое описание действия, сформированное из деталей, комментария и связанного тикета."
          },
          "performedBy": {
            "type": "string",
            "description": "ФИО пользователя или «Система» для автоматического действия."
          },
          "userId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Структурированные детали действия из AssetHistoryLog.Details."
          },
          "ticketId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время действия; соответствует ChangedAt в модели истории."
          }
        }
      },
      "AssetTicketHistoryItem": {
        "type": "object",
        "required": [
          "id",
          "typeId",
          "typeName",
          "title",
          "creatorId",
          "creatorName",
          "statusId",
          "statusName",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Системный номер заявки."
          },
          "typeId": {
            "type": "integer",
            "format": "int32"
          },
          "typeName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "creatorId": {
            "type": "integer",
            "format": "int32"
          },
          "creatorName": {
            "type": "string"
          },
          "assigneeId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "assigneeName": {
            "type": "string",
            "nullable": true
          },
          "statusId": {
            "type": "integer",
            "format": "int32"
          },
          "statusName": {
            "type": "string"
          },
          "criticalityLevelId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "criticalityName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "AssignmentSettings": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "AutomaticLeastLoaded",
              "Manual"
            ]
          },
          "manualAssignerUserId": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "При ручном режиме — пользователь, определенный администратором; null означает, что назначать может администратор."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateAssignmentSettingsRequest": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "AutomaticLeastLoaded",
              "Manual"
            ]
          },
          "manualAssignerUserId": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "Допустим только для Manual; null означает, что назначать может администратор."
          }
        }
      },
      "EscalationRule": {
        "type": "object",
        "required": [
          "ticketTypeId",
          "onSlaBreach",
          "onManual",
          "isActive"
        ],
        "properties": {
          "ticketTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "onSlaBreach": {
            "type": "boolean",
            "description": "Запускать эскалацию при нарушении времени решения по SLA."
          },
          "onManual": {
            "type": "boolean",
            "description": "Разрешить ручной запуск автором заявки или исполнителем согласно их ролям."
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UpdateEscalationRuleRequest": {
        "type": "object",
        "required": [
          "onSlaBreach",
          "onManual",
          "isActive"
        ],
        "properties": {
          "onSlaBreach": {
            "type": "boolean"
          },
          "onManual": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ReportType": {
        "type": "string",
        "enum": [
          "TicketsByStatus",
          "TicketsByTypeAndCriticality",
          "SlaCompliance",
          "AssigneeLoad",
          "AssigneePerformance",
          "InspectionReturns",
          "RepairsSummary",
          "AssetsByLifecycleStage",
          "AssetMovements"
        ]
      },
      "ReportAccessSetting": {
        "type": "object",
        "required": [
          "reportType",
          "allowedRoleCodes"
        ],
        "properties": {
          "reportType": {
            "$ref": "#/components/schemas/ReportType"
          },
          "allowedRoleCodes": {
            "type": "array",
            "description": "Системные коды ролей, которым разрешен просмотр отчета.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TicketsByStatusReportRow": {
        "type": "object",
        "required": [
          "statusId",
          "statusName",
          "ticketCount"
        ],
        "properties": {
          "statusId": {
            "type": "integer",
            "format": "int32"
          },
          "statusName": {
            "type": "string"
          },
          "ticketCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TicketsByTypeAndCriticalityReportRow": {
        "type": "object",
        "required": [
          "ticketTypeId",
          "ticketTypeName",
          "criticalityLevelId",
          "criticalityName",
          "ticketCount"
        ],
        "properties": {
          "ticketTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "ticketTypeName": {
            "type": "string"
          },
          "criticalityLevelId": {
            "type": "integer",
            "format": "int32"
          },
          "criticalityName": {
            "type": "string"
          },
          "ticketCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SlaComplianceReportRow": {
        "type": "object",
        "required": [
          "ticketTypeId",
          "ticketTypeName",
          "criticalityLevelId",
          "criticalityName",
          "ticketCount",
          "reactionBreachCount",
          "reactionBreachRate",
          "resolutionBreachCount",
          "resolutionBreachRate"
        ],
        "properties": {
          "ticketTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "ticketTypeName": {
            "type": "string"
          },
          "criticalityLevelId": {
            "type": "integer",
            "format": "int32"
          },
          "criticalityName": {
            "type": "string"
          },
          "ticketCount": {
            "type": "integer",
            "format": "int32"
          },
          "reactionBreachCount": {
            "type": "integer",
            "format": "int32"
          },
          "reactionBreachRate": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Доля от 0 до 1."
          },
          "resolutionBreachCount": {
            "type": "integer",
            "format": "int32"
          },
          "resolutionBreachRate": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Доля от 0 до 1."
          }
        }
      },
      "AssigneeLoadReportRow": {
        "type": "object",
        "required": [
          "assigneeId",
          "assigneeName",
          "openTicketCount"
        ],
        "properties": {
          "assigneeId": {
            "type": "integer",
            "format": "int32"
          },
          "assigneeName": {
            "type": "string"
          },
          "openTicketCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AssigneePerformanceReportRow": {
        "type": "object",
        "required": [
          "assigneeId",
          "assigneeName",
          "closedTicketCount",
          "averageReactionMinutes",
          "averageResolutionMinutes"
        ],
        "properties": {
          "assigneeId": {
            "type": "integer",
            "format": "int32"
          },
          "assigneeName": {
            "type": "string"
          },
          "closedTicketCount": {
            "type": "integer",
            "format": "int32"
          },
          "averageReactionMinutes": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "averageResolutionMinutes": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "InspectionReturnsReportRow": {
        "type": "object",
        "required": [
          "returnedTicketCount"
        ],
        "properties": {
          "returnedTicketCount": {
            "type": "integer",
            "format": "int32",
            "description": "Число заявок, возвращенных авторами из статуса проверки в статус ожидания выполнения."
          }
        }
      },
      "RepairsSummaryReportRow": {
        "type": "object",
        "required": [
          "assetId",
          "assetName",
          "assetClassId",
          "assetClassName",
          "outcome",
          "ticketCount"
        ],
        "properties": {
          "assetId": {
            "type": "integer",
            "format": "int32"
          },
          "inventoryNumber": {
            "type": "string",
            "nullable": true
          },
          "assetName": {
            "type": "string"
          },
          "assetClassId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "assetClassName": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ReturnToExploitation",
              "TransferToWarehouse",
              "Retire"
            ]
          },
          "ticketCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AssetsByLifecycleStageReportRow": {
