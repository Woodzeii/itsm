            "name": "ticketTypeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEscalationRuleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Правило эскалации сохранено"
          },
          "404": {
            "description": "Тип заявки не найден"
          }
        }
      }
    },
    "/api/ticket-configuration/service-desk-head": {
      "get": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Получить назначенного руководителя службы поддержки (ESC-05)",
        "description": "Только администратор. Руководитель службы поддержки — отдельная системная настройка и не совпадает с managerId, который задает организационную иерархию пользователя.",
        "responses": {
          "200": {
            "description": "Назначенный руководитель либо отсутствие назначения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDeskHeadSetting"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Назначить руководителя службы поддержки (ESC-05)",
        "description": "Только администратор. userId должен принадлежать активному инженеру технической поддержки. Руководитель является получателем эскалаций; это не изменение managerId или роли пользователя.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetServiceDeskHeadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Руководитель службы поддержки назначен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDeskHeadSetting"
                }
              }
            }
          },
          "400": {
            "description": "Пользователь не является активным инженером технической поддержки."
          },
          "404": {
            "description": "Пользователь не найден."
          }
        }
      }
    },
    "/api/criticality-levels": {
      "get": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Получить шкалу критичности",
        "description": "Только администратор. В системе должно оставаться от 3 до 5 активных уровней (SD-11).",
        "responses": {
          "200": {
            "description": "Уровни критичности",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CriticalityLevel"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Добавить уровень критичности",
        "description": "Только администратор. Не допускается превышать пять активных уровней.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCriticalityLevelRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Уровень создан"
          },
          "409": {
            "description": "Достигнут максимум уровней или код уже используется"
          }
        }
      }
    },
    "/api/criticality-levels/{id}": {
      "put": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Изменить уровень критичности",
        "description": "Только администратор. Уровни, используемые существующими заявками, не удаляются физически. При isActive=false должно остаться не менее 3 активных уровней; при isActive=true активных уровней должно быть не более 5. Нарушение ограничений возвращает 400.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCriticalityLevelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Уровень критичности обновлен"
          },
          "400": {
            "description": "Нарушено ограничение шкалы критичности: после изменения должно оставаться строго от 3 до 5 активных уровней (SD-11)."
          },
          "404": {
            "description": "Уровень не найден"
          }
        }
      }
    },
    "/api/ticket-statuses/{id}": {
      "put": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Изменить название или настройки статуса",
        "description": "Только администратор. Стандартные статусы можно переименовать, но нельзя удалить.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTicketStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Статус обновлен"
          },
          "404": {
            "description": "Статус не найден"
          }
        }
      }
    },
    "/api/ticket-status-transitions": {
      "get": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Получить разрешенные переходы между статусами",
        "description": "Только администратор.",
        "responses": {
          "200": {
            "description": "Правила переходов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketStatusTransition"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "TicketConfiguration"
        ],
        "summary": "Заменить конфигурацию переходов статусов",
        "description": "Только администратор. Каждый переход задает начальный статус, конечный статус и необязательный код роли. MVP принимает полный массив и заменяет всю матрицу. Удаление старых строк и вставка новых должны выполняться атомарно в одной транзакции. При одновременном редактировании несколькими администраторами сохраняется риск гонки и потери обновлений.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SaveTicketStatusTransitionRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Переходы сохранены"
          }
        }
      }
    }
  },
