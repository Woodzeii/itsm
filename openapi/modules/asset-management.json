        ],
        "summary": "Получить историю изменений",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "История изменений актива",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetHistoryItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/{id}/tickets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Получить историю заявок по активу с фильтрацией (HIST-05, HIST-06)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "typeId",
            "in": "query",
            "required": false,
            "description": "Фильтр по типу заявки.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "statusId",
            "in": "query",
            "required": false,
            "description": "Фильтр по статусу заявки.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "criticalityLevelId",
            "in": "query",
            "required": false,
            "description": "Фильтр по критичности.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "assigneeId",
            "in": "query",
            "required": false,
            "description": "Фильтр по исполнителю.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": false,
            "description": "Начальная дата создания, включительно.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": false,
            "description": "Конечная дата создания, включительно.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "История заявок по активу: номер, тип, тема, автор, исполнитель, статус, критичность, дата создания и дата закрытия.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetTicketHistoryItem"
                  }
                }
              }
            }
          }
        }
      }
    },
