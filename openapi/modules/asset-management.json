          }
        }
      },
      "put": {
        "tags": [
          "Assets"
        ],
        "summary": "Редактировать атрибуты карточки актива",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAssetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Assets"
        ],
        "summary": "Удалить актив (допускается только на этапе 'Закуплен')",
        "description": "Удаление разрешено только пока актив находится на этапе «Закуплен» (АКТ-14). Для активов на других этапах возвращается 409 Conflict.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "409": {
            "description": "Удаление невозможно: актив находится на этапе, отличном от «Закуплен» (АКТ-14)."
          }
        }
      }
    },
